<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ecotrack.GestionCentroController" style="-fx-background-color: #f4f7f6;">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="EcoTrack" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label text="| Central de Procesamiento" style="-fx-text-fill: #7f8c8d;">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
    </HBox>
    <Separator />

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <VBox spacing="15" prefWidth="350" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <Label text="Residuos por Procesar" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 16;"/>
            
            <ListView fx:id="lstPilaResiduos" VBox.vgrow="ALWAYS" style="-fx-background-radius: 5;"/>
            
            <VBox spacing="10" alignment="CENTER">
                <Button text="PROCESAR SIGUIENTE" onAction="#handleProcesar" maxWidth="Infinity" prefHeight="45" 
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 25;"/>
                <Label fx:id="lblEstadoPila" text="Residuos en espera: 0" style="-fx-font-style: italic;"/>
            </VBox>
        </VBox>

        <VBox spacing="20" HBox.hgrow="ALWAYS">
            
            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <Label text="Acumulado por Tipo de Residuo" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                <TableView fx:id="tblEstadisticasTipo" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTipo" text="Tipo de Material" prefWidth="200"/>
                        <TableColumn fx:id="colPesoTipo" text="Peso Total (kg)" prefWidth="150"/>
                    </columns>
                </TableView>
                
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <Label text="Zonas con Mayor Generación (Peso)" style="-fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                <TableView fx:id="tblEstadisticasZona" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colZona" text="Zona de Origen" prefWidth="200"/>
                        <TableColumn fx:id="colPesoZona" text="Peso Total (kg)" prefWidth="150"/>
                    </columns>
                </TableView>
                
            </VBox>
            <Button text="Imprimir" onAction="#handleImprimir" maxWidth="Infinity" prefHeight="45" 
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 25;"/>
        </VBox>
    </HBox>

    <Button text="Regresar al Menú Principal" onAction="#handleRegresar" prefWidth="250" prefHeight="35"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20;"/>
</VBox>