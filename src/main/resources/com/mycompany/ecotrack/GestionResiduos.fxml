<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ecotrack.GestionResiduosController" style="-fx-background-color: #f9f9f9;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="EcoTrack" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label text="| Gestión de Residuos" style="-fx-text-fill: #7f8c8d;">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
    </HBox>
    <Separator />

    <HBox spacing="30" alignment="CENTER" VBox.vgrow="ALWAYS">
        
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" prefWidth="400">
            <Label text="Registrar Nuevo Residuo" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            
            <GridPane hgap="10" vgap="12">
                <Label text="ID del Residuo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtId" promptText="Ej: R-001" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Ej: Botellas PET" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbTipo" prefWidth="200" promptText="Seleccione tipo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Peso (kg):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPeso" promptText="0.0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Fecha Recolección:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha" prefWidth="200" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Zona Asignada:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbZona" prefWidth="200" promptText="Seleccione zona" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Prioridad Ambiental:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <Slider fx:id="sldPrioridad" min="1" max="5" value="1" majorTickUnit="1" minorTickCount="0" showTickLabels="true" snapToTicks="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>
            
            <VBox spacing="10">
                <Button text="Registrar en Lista" onAction="#handleRegistrar" maxWidth="Infinity" prefHeight="35" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20;"/>
                <Button text="Guardar Cambios (.txt)" onAction="#handleGuardar" maxWidth="Infinity" prefHeight="35" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20;"/>
            </VBox>
        </VBox>

        <VBox spacing="15" prefWidth="450" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #dcdde1; -fx-border-radius: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Ordenar residuos por:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbOrden" onAction="#handleCambiarOrden" prefWidth="150" promptText="Criterio"/>
            </HBox>

            <VBox spacing="8" style="-fx-border-color: #3498db; -fx-border-width: 0 0 0 5; -fx-padding: 15; -fx-background-color: #f7fbfe;">
                <Label fx:id="lblResumenId" text="ID: ---" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                <Separator />
                <GridPane hgap="10" vgap="5">
                    <Label text="Nombre:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblResumenNombre" text="---" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Categoría:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblResumenTipo" text="---" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Peso Actual:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblResumenPeso" text="---" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Fecha:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="lblResumenFecha" text="---" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Zona:" style="-fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="lblResumenZona" text="---" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Prioridad:" style="-fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="lblResumenPrioridad" text="---" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <HBox spacing="20" alignment="CENTER">
                <Button text="◀ Anterior" onAction="#handleAnterior" prefWidth="120" prefHeight="35" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;"/>
                <Label fx:id="lblContador" text="Residuos: 0" style="-fx-font-style: italic;"/>
                <Button text="Siguiente ▶" onAction="#handleSiguiente" prefWidth="120" prefHeight="35" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;"/>
            </HBox>
        </VBox>
    </HBox>

    <Button text="Regresar al Menú Principal" onAction="#irAlMenu" prefWidth="300" prefHeight="40" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 25;"/>
</VBox>