<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="40.0" style="-fx-background-color: linear-gradient(to bottom, #E8F5E9, #F1F8E9);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ecotrack.LoginController">
   <children>
      
      <Label fx:id="lblTitulo" text="EcoTrack" textFill="#2D5A27">
         <font>
            <Font name="Segoe UI Bold" size="60.0" />
         </font>
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
         <effect>
            <DropShadow blurType="GAUSSIAN" color="#00000015" radius="5.0" />
         </effect>
      </Label>
      
      <VBox alignment="CENTER" maxWidth="460.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 55; -fx-background-radius: 35; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.07), 30, 0, 0, 10);">
         <children>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="Usuario" textFill="#555555">
                     <font>
                        <Font name="Segoe UI Bold" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="campoUsuario" alignment="CENTER" prefHeight="45.0" promptText="Ingrese su usuario" style="-fx-background-radius: 15; -fx-border-color: #EAEAEA; -fx-border-radius: 15; -fx-background-color: #FAFAFA;" />
               </children>
            </VBox>
            
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="Contraseña" textFill="#555555">
                     <font>
                        <Font name="Segoe UI Bold" size="14.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="campoContrasena" alignment="CENTER" prefHeight="45.0" promptText="********" style="-fx-background-radius: 15; -fx-border-color: #EAEAEA; -fx-border-radius: 15; -fx-background-color: #FAFAFA;" />
               </children>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </VBox>
            
            <Button fx:id="botonLogin" maxWidth="Infinity" mnemonicParsing="false" onAction="#validarLogin" prefHeight="50.0" style="-fx-background-color: #5CB85C; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="Iniciar Sesión">
               <VBox.margin>
                  <Insets top="25.0" />
               </VBox.margin>
               <font>
                  <Font name="Segoe UI Bold" size="16.0" />
               </font>
            </Button>

            <Hyperlink fx:id="linkRegistro" onAction="#alternarModo" text="¿No tienes cuenta? Regístrate aquí" textFill="#4CAF50">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <font>
                  <Font name="Segoe UI" size="13.0" />
               </font>
            </Hyperlink>
         </children>
      </VBox>
      
      <Label text="Sistema Inteligente de Gestión de Residuos" textFill="#7A9A7A">
         <font>
            <Font name="Segoe UI Italic" size="12.0" />
         </font>
      </Label>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>