<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="900.0" spacing="0.0" style="-fx-background-color: #F4F9F4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ecotrack.MenuDashboardController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <children>
                <Label text="EcoTrack" textFill="#2D5A27">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="25.0" />
                    </HBox.margin>
                </Label>
                <Label text=" | Panel de Control" textFill="#888888">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                
                <Pane HBox.hgrow="ALWAYS" />
                
                <Button mnemonicParsing="false" onAction="#handleLogout" 
                        style="-fx-background-color: #E57373; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" 
                        text="Cerrar Sesión">
                    <HBox.margin>
                        <Insets right="25.0" />
                    </HBox.margin>
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                </Button>
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Bienvenido al Sistema Inteligente de Gestión de Residuos" textFill="#555555">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="260.0" prefWidth="240.0" spacing="15.0" 
                              style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                            <children>
                                <Label text="♻️" style="-fx-font-size: 45;" />
                                <Label text="Gestión de Residuos" textFill="#2D5A27">
                                    <font><Font name="System Bold" size="17.0" /></font>
                                </Label>
                                <Label text="Lista Circular Doble" textFill="#999999" />
                                <Button fx:id="btnResiduos" onAction="#goToResiduos" prefWidth="120.0" 
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Administrar" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="260.0" prefWidth="240.0" spacing="15.0" 
                              style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                            <children>
                                <Label text="🚛" style="-fx-font-size: 45;" />
                                <Label text="Rutas de Recolección" textFill="#2D5A27">
                                    <font><Font name="System Bold" size="17.0" /></font>
                                </Label>
                                <Label text="Cola de Prioridad" textFill="#999999" />
                                <Button fx:id="btnLogistica" onAction="#goToLogistica" prefWidth="120.0" 
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Ver Rutas" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="260.0" prefWidth="240.0" spacing="15.0" 
                              style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                            <children>
                                <Label text="📈" style="-fx-font-size: 45;" />
                                <Label text="Centro de Reciclaje" textFill="#2D5A27">
                                    <font><Font name="System Bold" size="17.0" /></font>
                                </Label>
                                <Label text="Pilas y Reportes" textFill="#999999" />
                                <Button fx:id="btnEstadisticas" onAction="#goToEstadisticas" prefWidth="120.0" 
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="Analizar" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
        
        <Label text="EcoTrack 2026 - Sistema de Gestión Urbana" textFill="#aaaaaa">
            <VBox.margin><Insets bottom="15.0" /></VBox.margin>
            <font><Font size="10.0" /></font>
        </Label>
    </children>
</VBox>
