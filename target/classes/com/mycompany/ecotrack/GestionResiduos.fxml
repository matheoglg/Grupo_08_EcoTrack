<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ecotrack.GestionResiduosController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestión de Residuos EcoTrack" style="-fx-font-weight: bold;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <Separator />

    <HBox spacing="40" alignment="CENTER">
        <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-padding: 15; -fx-border-radius: 5;">
            <Label text="Nuevo Registro" style="-fx-font-weight: bold" />
            <GridPane hgap="10" vgap="10">
                <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbTipo" prefWidth="150" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Peso (kg):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPeso" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Fecha:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Zona:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbZona" prefWidth="150" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Prioridad (1-5):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <Slider fx:id="sldPrioridad" min="1" max="5" showTickLabels="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>
            <Button text="Registrar Residuo" onAction="#handleRegistrar" maxWidth="Infinity" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER" style="-fx-border-color: #3498db; -fx-padding: 20; -fx-border-radius: 5;" prefWidth="300">
            <Label text="Visor de Lista Circular" style="-fx-font-weight: bold" />
            
            <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #f4f4f4; -fx-padding: 10;">
                <Label fx:id="lblResumenId" text="ID: ---" style="-fx-font-family: 'Monospaced';"/>
                <Label fx:id="lblResumenNombre" text="Nombre: ---" />
                <Label fx:id="lblResumenTipo" text="Tipo: ---" />
                <Label fx:id="lblResumenPrioridad" text="Prioridad: ---" style="-fx-text-fill: red;"/>
            </VBox>

            <HBox spacing="15" alignment="CENTER">
                <Button text="⬅ Anterior" onAction="#handleAnterior" />
                <Button text="Siguiente ➡" onAction="#handleSiguiente" />
            </HBox>
            
            <Label fx:id="lblContador" text="Residuo X de Y" textFill="#797979" />
        </VBox>
    </HBox>

    <Button text="Guardar y Salir" onAction="#handleGuardar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
</VBox>